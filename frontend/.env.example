# RAGGuard frontend environment template. Copy to `frontend/.env.local` if you need to change it.
#
# Every VITE_* variable is compiled into the browser bundle and is PUBLIC.
# Never put API keys (Gemini or otherwise), credentials, or backend secrets here.

# Base URL of the RAGGuard backend API. Default for local development:
VITE_API_BASE_URL=http://localhost:8000

# Public GitHub repository (owner/name) whose Actions runs the Pipeline view lists. The browser
# reads GitHub's public API anonymously (60 requests/hour); there is no token and none is needed.
# Leave unset for the project's own repository.
# VITE_GITHUB_REPOSITORY=MehulSharmaCode/RAGGuard
