# RAGGuard environment template
#
# Copy to `.env` (repository root) for local development and fill in real values
# there. `.env` is git-ignored. Never commit real credentials to this file.
# Every variable is optional; the values shown are the backend defaults.
# Variables for later stages are provisional and confirmed in the stage that
# first uses them (see docs/ROADMAP.md and docs/DECISIONS.md).

# --- Application (Stage 2) -------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Host/port are passed to uvicorn on the command line; listed for reference.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Generation (Stage 2) --------------------------------------
# Supported: ollama (default, local) | gemini (optional, hosted)
GENERATION_PROVIDER=ollama
GENERATION_TEMPERATURE=0.1

# Ollama: local inference, no API key. The model must already be installed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=180

# Gemini: only used when GENERATION_PROVIDER=gemini. Put the real key in .env only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings (Stage 2) --------------------------------------
# Local Sentence Transformers model; downloaded to the Hugging Face cache on first use.
# Changing it requires a new QDRANT_COLLECTION_NAME (vector size must match).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store: Qdrant (Stage 2) ----------------------------
# Leave QDRANT_URL empty to use embedded local persistent storage at
# QDRANT_LOCAL_PATH (relative paths resolve from the repository root).
# Set QDRANT_URL (e.g. http://localhost:6333) to use a Qdrant server instead.
QDRANT_URL=
QDRANT_LOCAL_PATH=qdrant_storage
QDRANT_COLLECTION_NAME=ragguard_chunks
# Only required for a secured / hosted Qdrant server
QDRANT_API_KEY=

# --- Ingestion and retrieval (Stage 2, provisional; tuned in Stage 4) --
CHUNK_SIZE_TOKENS=180
CHUNK_OVERLAP_TOKENS=30
DEFAULT_TOP_K=4
MAX_UPLOAD_SIZE_MB=10
# Cosine similarity in [-1, 1]; chunks below this are not used as evidence.
MIN_RETRIEVAL_SCORE=0.35

# --- Experiment tracking: MLflow (Stage 5) ---------------------
MLFLOW_TRACKING_URI=

# --- Frontend (Stage 3) ----------------------------------------
# Frontend variables live in frontend/.env.example (Vite reads env files from
# frontend/, not from the repository root).
