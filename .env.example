# RAGGuard environment template
#
# Copy to `.env` (repository root) for local development and fill in real values
# there. `.env` is git-ignored. Never commit real credentials to this file.
# Every variable is optional; the values shown are the backend defaults.
# Variables for later stages are provisional and confirmed in the stage that
# first uses them (see docs/ROADMAP.md and docs/DECISIONS.md).

# --- Application (Stage 2) -------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Host/port are passed to uvicorn on the command line; listed for reference.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Generation (Stage 2) --------------------------------------
# Supported: ollama (default, local) | gemini (optional, hosted)
GENERATION_PROVIDER=ollama
GENERATION_TEMPERATURE=0.1

# Ollama: local inference, no API key. The model must already be installed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=180

# Gemini: only used when GENERATION_PROVIDER=gemini. Put the real key in .env only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings (Stage 2) --------------------------------------
# Local Sentence Transformers model; downloaded to the Hugging Face cache on first use.
# Changing it requires a new QDRANT_COLLECTION_NAME (vector size must match).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store: Qdrant (Stage 2) ----------------------------
# Leave QDRANT_URL empty to use embedded local persistent storage at
# QDRANT_LOCAL_PATH (relative paths resolve from the repository root).
# Set QDRANT_URL (e.g. http://localhost:6333) to use a Qdrant server instead.
QDRANT_URL=
QDRANT_LOCAL_PATH=qdrant_storage
QDRANT_COLLECTION_NAME=ragguard_chunks
# Only required for a secured / hosted Qdrant server
QDRANT_API_KEY=

# --- Ingestion and retrieval (Stage 2; threshold re-measured in Stage 5) --
CHUNK_SIZE_TOKENS=180
CHUNK_OVERLAP_TOKENS=30
DEFAULT_TOP_K=4
MAX_UPLOAD_SIZE_MB=10
# A chunk's score is the cosine similarity of its best-matching vector (the whole chunk
# or one of its structural sub-units: rows, list items, sentences); chunks below this are
# not used as evidence. 0.35 since 2026-10-16 for this score (docs/DECISIONS.md D-063).
# Collections indexed before then (single-vector "legacy" index) always use 0.30 (D-052).
MIN_RETRIEVAL_SCORE=0.35

# Developer diagnostics (D-066): when true, POST /diagnostics/query shows the retrieval
# candidates, scores, evidence decision and (with "generate": true) the model's raw reply
# for a question. Keep false outside local debugging.
RETRIEVAL_DIAGNOSTICS=false

# --- Experiment tracking: MLflow (Stage 5) ---------------------
# The evaluation CLI logs runs here; since Stage 5.5 the API also READS this
# store for the Experiments view (read-only, MLflow imported lazily; the query
# path never uses it). Empty: local SQLite store mlflow.db in the repository
# root, artifacts in mlartifacts/ (both git-ignored). Set e.g.
# http://127.0.0.1:5050 to use a running MLflow server instead.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=ragguard-evaluation
# Folder for the artifacts of a NEW experiment (default: mlartifacts/ in the repository
# root). An existing experiment keeps the location recorded in its store. The Docker
# image sets /data/mlflow/artifacts (D-075); leave empty for local development.
MLFLOW_ARTIFACT_ROOT=

# --- Evaluation files (Stage 5.5) -------------------------------
# Defaults of the evaluation CLI and the locations the API reads (read-only) for
# the Evaluation and Pipeline views. Leave commented out to use the defaults;
# relative paths resolve from the repository root. Do not set them to an empty
# value (that would mean the repository root).
# EVALUATION_DATASET_PATH=evaluation/datasets/dataset.json
# EVALUATION_RESULTS_DIR=evaluation/results

# --- Docker Compose deployment (Stage 6) ------------------------
# `docker compose up -d --build` (see deployment/README.md) reads these from the shell or
# from this file. Only the variables below reach the backend container; host-only values
# above (OLLAMA_BASE_URL, QDRANT_URL, QDRANT_LOCAL_PATH, MLFLOW_*, ...) are NOT passed on,
# so one .env can serve both the host development setup and Compose.
# Shared with the host setup (same meaning, passed through when set): LOG_LEVEL,
# GENERATION_PROVIDER, OLLAMA_MODEL, OLLAMA_TIMEOUT_SECONDS, GEMINI_API_KEY, GEMINI_MODEL,
# EMBEDDING_MODEL, QDRANT_COLLECTION_NAME.
# Port of the web UI on the host, and the address it listens on. 127.0.0.1 keeps the app
# private to this machine; 0.0.0.0 would expose it (no login exists) to the whole network.
WEB_PORT=8080
WEB_BIND=127.0.0.1
# How the backend CONTAINER reaches Ollama running on the host (not localhost: that would be
# the container itself). Docker Desktop resolves host.docker.internal; on Linux Ollama must
# also listen on 0.0.0.0 (OLLAMA_HOST).
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# 1 = never contact Hugging Face (works once the model is in the hf_cache volume).
HF_HUB_OFFLINE=0

# --- Frontend (Stage 3) ----------------------------------------
# Frontend variables live in frontend/.env.example (Vite reads env files from
# frontend/, not from the repository root).
